<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cc.xlei.fuckipv6</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/fuckipv6/fuckipv6</string>
    <string>__service</string>
    <string>--options-file</string>
    <string>/usr/local/etc/fuckipv6/service.json</string>
    <string>--config-dir</string>
    <string>/usr/local/etc/fuckipv6</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/usr/local/var/lib/fuckipv6</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>FUCKIPV6_RUNTIME_DIR</key>
    <string>/usr/local/var/run/fuckipv6</string>
    <key>RUST_LOG</key>
    <string>info</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ExitTimeOut</key>
  <integer>75</integer>

  <key>StandardOutPath</key>
  <string>/usr/local/var/log/fuckipv6/node.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/fuckipv6/node.err.log</string>
</dict>
</plist>
