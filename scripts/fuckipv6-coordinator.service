[Unit]
Description=fuckipv6 Coordinator - IPv6 Virtual LAN Coordination Server
Documentation=https://github.com/yourusername/fuckipv6
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fuckipv6
Group=fuckipv6

# 工作目录（修改为实际路径）
WorkingDirectory=/opt/fuckipv6

# 可执行文件路径（修改为实际路径）
ExecStart=/opt/fuckipv6/fuckipv6-coordinator --bind "[::]:6666" --ip-pool "fd00::1000/120"

# 环境变量
Environment="RUST_LOG=info"

# 重启策略
Restart=always
RestartSec=5s

# 限制重启频率
StartLimitInterval=10s
StartLimitBurst=3

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/fuckipv6

# 资源限制
LimitNOFILE=65536

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fuckipv6-coordinator

[Install]
WantedBy=multi-user.target
