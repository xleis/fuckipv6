{
  "$defs": {
    "CapabilityKind": {
      "description": "The fixed first-version capability set. Unknown wire values fail closed at\ndeserialization and are never inferred from a free-form label.",
      "enum": [
        "coordinator",
        "relay",
        "exit",
        "file"
      ],
      "type": "string"
    },
    "ContentHash": {
      "description": "SHA-256/Blake3-style content digest represented without exposing secret input.",
      "type": "string"
    },
    "DiscoveryTransport": {
      "enum": [
        "quic",
        "tcp",
        "websocket",
        "local"
      ],
      "type": "string"
    },
    "ExitContributionObligation": {
      "description": "Exit contribution is an explicit network admission obligation, not a\ncapability silently enabled by joining.",
      "enum": [
        "required",
        "not_required"
      ],
      "type": "string"
    },
    "JoinRequestReviewAction": {
      "enum": [
        "approve",
        "reject",
        "request_information"
      ],
      "type": "string"
    },
    "NetworkDiscoveryDocument": {
      "description": "Signed discovery data. Endpoints may change between revisions; the stable\nnetwork ID remains bound to the immutable network public key.",
      "properties": {
        "administrators": {
          "default": [],
          "description": "Public governance roles disclosed before joining. Full member IDs,\nendpoints beyond the signed public hints, topology and activity remain\noutside this document.",
          "items": {
            "$ref": "#/$defs/NodeId"
          },
          "type": "array"
        },
        "capability_summary": {
          "description": "Canonical capability declaration summary. This is discoverability\nmetadata, not proof that a capability is currently operational.",
          "items": {
            "$ref": "#/$defs/CapabilityKind"
          },
          "type": "array"
        },
        "endpoints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NetworkEndpoint"
          },
          "type": "array"
        },
        "exit_contribution": {
          "$ref": "#/$defs/ExitContributionObligation",
          "default": "not_required"
        },
        "expires_at_unix_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "issued_at_unix_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "join_mode": {
          "$ref": "#/$defs/NetworkJoinMode"
        },
        "language": {
          "default": "und",
          "description": "Public discovery facets. Schema v2 includes these fields in the signed\npayload. Defaults keep older local JSON readable while validation still\nrejects records created under a different document schema.",
          "type": "string"
        },
        "member_count": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "member_limit": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "network_id": {
          "$ref": "#/$defs/NetworkId"
        },
        "owner": {
          "$ref": "#/$defs/NodeId"
        },
        "policy_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "privacy_changes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "privacy_policy_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "public_key": {
          "$ref": "#/$defs/PublicKey"
        },
        "publisher": {
          "$ref": "#/$defs/NodeId",
          "description": "Node that published this revision. Schema v1 binds the publisher to the\nnetwork owner so another member cannot publish an owner-authorized card."
        },
        "purpose": {
          "type": "string"
        },
        "region": {
          "default": "ZZ",
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "revoked_at_unix_ms": {
          "description": "A signed tombstone is a normal revision with this timestamp set. Once a\nclient accepts one, every older or non-identical successor is rejected.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "schema_version": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "visibility": {
          "$ref": "#/$defs/NetworkVisibility"
        }
      },
      "required": [
        "schema_version",
        "network_id",
        "public_key",
        "publisher",
        "name",
        "purpose",
        "visibility",
        "join_mode",
        "owner",
        "revision",
        "policy_revision",
        "privacy_policy_revision",
        "issued_at_unix_ms",
        "expires_at_unix_ms",
        "capability_summary"
      ],
      "type": "object"
    },
    "NetworkDiscoveryRecord": {
      "properties": {
        "document": {
          "$ref": "#/$defs/NetworkDiscoveryDocument"
        },
        "signature": {
          "$ref": "#/$defs/Signature"
        }
      },
      "required": [
        "document",
        "signature"
      ],
      "type": "object"
    },
    "NetworkEndpoint": {
      "description": "A decoupled discovery hint. It is never part of the stable network identity.",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "transport": {
          "$ref": "#/$defs/DiscoveryTransport"
        }
      },
      "required": [
        "transport",
        "host",
        "port"
      ],
      "type": "object"
    },
    "NetworkId": {
      "type": "string"
    },
    "NetworkJoinMode": {
      "description": "Admission policy selected by the network owner.",
      "oneOf": [
        {
          "const": "open",
          "description": "Requests are accepted immediately.",
          "type": "string"
        },
        {
          "const": "approval_required",
          "description": "Requests enter `pending_approval`.",
          "type": "string"
        },
        {
          "const": "invite_only",
          "description": "The node must first consume a signed, single-use invitation.",
          "type": "string"
        }
      ]
    },
    "NetworkMode": {
      "description": "虚拟网络工作模式",
      "oneOf": [
        {
          "const": "ipv4_only",
          "description": "仅使用 IPv4 虚拟内网",
          "type": "string"
        },
        {
          "const": "ipv6_only",
          "description": "仅使用 IPv6 虚拟内网",
          "type": "string"
        },
        {
          "const": "dual_stack",
          "description": "同时支持 IPv4 和 IPv6 虚拟双栈",
          "type": "string"
        }
      ]
    },
    "NetworkProfileUpdate": {
      "description": "Owner-editable public fields for an existing network. The network name and\nstable identity deliberately cannot be changed through this command.",
      "properties": {
        "capability_declarations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityKind"
          },
          "type": "array"
        },
        "icon": {
          "type": "string"
        },
        "join_mode": {
          "$ref": "#/$defs/NetworkJoinMode"
        },
        "language": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "visibility": {
          "$ref": "#/$defs/NetworkVisibility"
        }
      },
      "required": [
        "purpose",
        "icon",
        "language",
        "region",
        "visibility",
        "join_mode"
      ],
      "type": "object"
    },
    "NetworkVisibility": {
      "description": "How much of a network's public profile is discoverable without membership.",
      "enum": [
        "public",
        "unlisted",
        "private"
      ],
      "type": "string"
    },
    "NodeApplyConfigurationCommand": {
      "properties": {
        "expected_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "networks": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "expected_revision",
        "networks"
      ],
      "type": "object"
    },
    "NodeBatchReviewJoinRequestsCommand": {
      "properties": {
        "network_id": {
          "type": "string"
        },
        "reviews": {
          "items": {
            "$ref": "#/$defs/NodeJoinRequestReviewItem"
          },
          "type": "array"
        }
      },
      "required": [
        "network_id",
        "reviews"
      ],
      "type": "object"
    },
    "NodeClientBlacklistCommand": {
      "properties": {
        "client_id": {
          "type": "string"
        },
        "network_name": {
          "type": "string"
        }
      },
      "required": [
        "network_name",
        "client_id"
      ],
      "type": "object"
    },
    "NodeCreateNetworkCommand": {
      "properties": {
        "auto_connect": {
          "type": "boolean"
        },
        "capability_declarations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityKind"
          },
          "type": "array"
        },
        "external_host": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "default": "network",
          "type": "string"
        },
        "join_mode": {
          "$ref": "#/$defs/NetworkJoinMode",
          "default": "invite_only"
        },
        "language": {
          "default": "und",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "default": "Owner-created network",
          "type": "string"
        },
        "region": {
          "default": "ZZ",
          "type": "string"
        },
        "relay_port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "signaling_port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "visibility": {
          "$ref": "#/$defs/NetworkVisibility",
          "default": "unlisted"
        }
      },
      "required": [
        "name",
        "signaling_port",
        "relay_port",
        "auto_connect"
      ],
      "type": "object"
    },
    "NodeId": {
      "type": "string"
    },
    "NodeJoinNetworkCommand": {
      "properties": {
        "acknowledged_at_unix_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "discovery_record": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkDiscoveryRecord"
            },
            {
              "type": "null"
            }
          ],
          "description": "Public signed discovery material selected by the user. It is never\ntrusted as cached authority: the handler replaces or revalidates it from\nthe persisted discovery snapshot immediately before mutation."
        },
        "network_id": {
          "description": "Stable network selected from a discovery preview.",
          "type": [
            "string",
            "null"
          ]
        },
        "network_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "network_policy_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "preview_digest": {
          "description": "Exact discovery digest shown in the preview.",
          "type": [
            "string",
            "null"
          ]
        },
        "privacy_policy_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "start": {
          "type": "boolean"
        },
        "target": {
          "type": "string"
        },
        "terms_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentHash"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target",
        "start"
      ],
      "type": "object"
    },
    "NodeJoinRequestReviewItem": {
      "properties": {
        "action": {
          "$ref": "#/$defs/JoinRequestReviewAction"
        },
        "expected_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "expected_revision",
        "action"
      ],
      "type": "object"
    },
    "NodeLeaveNetworkCommand": {
      "properties": {
        "network_name": {
          "type": "string"
        }
      },
      "required": [
        "network_name"
      ],
      "type": "object"
    },
    "NodeListJoinRequestsCommand": {
      "properties": {
        "network_id": {
          "type": "string"
        }
      },
      "required": [
        "network_id"
      ],
      "type": "object"
    },
    "NodeNetworkAllocation": {
      "description": "Transport-neutral allocation payload shared by local adapters and the\nnode command protocol. Persistence is owned by the embedded service actor,\nnever by a UI adapter.",
      "properties": {
        "ipv4_pool": {
          "type": "string"
        },
        "ipv6_pool": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/NetworkMode"
        }
      },
      "required": [
        "mode",
        "ipv4_pool",
        "ipv6_pool"
      ],
      "type": "object"
    },
    "NodeNetworkDiscoveryCommand": {
      "properties": {
        "index_url": {
          "type": "string"
        },
        "network_name": {
          "type": "string"
        }
      },
      "required": [
        "network_name",
        "index_url"
      ],
      "type": "object"
    },
    "NodeNetworkProfileCommand": {
      "properties": {
        "expected_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "network_name": {
          "type": "string"
        },
        "update": {
          "$ref": "#/$defs/NetworkProfileUpdate"
        }
      },
      "required": [
        "network_name",
        "expected_revision",
        "update"
      ],
      "type": "object"
    },
    "NodeNetworkRole": {
      "description": "Network roles are capabilities within a network, never product identities.",
      "enum": [
        "member",
        "discovery",
        "relay",
        "exit_node"
      ],
      "type": "string"
    },
    "NodeNetworkSelection": {
      "description": "How a node should choose the networks it loads at startup.",
      "oneOf": [
        {
          "enum": [
            "default",
            "all"
          ],
          "type": "string"
        },
        {
          "const": "none",
          "description": "Keep the node and its control surfaces running without joining a network.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "named": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "named"
          ],
          "type": "object"
        }
      ]
    },
    "NodePreviewConfigurationCommand": {
      "description": "Complete document imported by an owner for preview or atomic apply.\nActor and request source are intentionally absent: the command bus supplies\nthem from the authenticated transport context.",
      "properties": {
        "expected_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "networks": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "expected_revision",
        "networks"
      ],
      "type": "object"
    },
    "NodePreviewJoinNetworkCommand": {
      "properties": {
        "network_id": {
          "type": "string"
        }
      },
      "required": [
        "network_id"
      ],
      "type": "object"
    },
    "NodeProbePeerCommand": {
      "properties": {
        "network_name": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "network_name",
        "target",
        "timeout_ms"
      ],
      "type": "object"
    },
    "NodeResubmitJoinRequestCommand": {
      "properties": {
        "expected_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "network_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "network_id",
        "request_id",
        "expected_revision",
        "reason"
      ],
      "type": "object"
    },
    "NodeReviewJoinRequestCommand": {
      "properties": {
        "network_id": {
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/NodeJoinRequestReviewItem"
        }
      },
      "required": [
        "network_id",
        "review"
      ],
      "type": "object"
    },
    "NodeRollbackConfigurationCommand": {
      "properties": {
        "expected_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "target_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "expected_revision",
        "target_revision"
      ],
      "type": "object"
    },
    "NodeRotateNodeIdentityCommand": {
      "properties": {
        "expected_fingerprint": {
          "description": "The current public-key fingerprint shown to the owner. Requiring it\nprevents a stale UI from rotating a newer identity that it has not seen.",
          "type": "string"
        }
      },
      "required": [
        "expected_fingerprint"
      ],
      "type": "object"
    },
    "NodeRoutingMode": {
      "enum": [
        "mesh_only",
        "bypass_mainland",
        "global_proxy"
      ],
      "type": "string"
    },
    "NodeSetNetworkRoleCommand": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "network_name": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/NodeNetworkRole"
        }
      },
      "required": [
        "network_name",
        "role",
        "enabled"
      ],
      "type": "object"
    },
    "NodeSetNodeDisplayNameCommand": {
      "properties": {
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "NodeSubmitJoinRequestCommand": {
      "properties": {
        "network_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "network_id",
        "reason"
      ],
      "type": "object"
    },
    "NodeUpdateNetworkAllocationCommand": {
      "properties": {
        "allocation": {
          "$ref": "#/$defs/NodeNetworkAllocation"
        },
        "network_name": {
          "type": "string"
        }
      },
      "required": [
        "network_name",
        "allocation"
      ],
      "type": "object"
    },
    "NodeUpdateRoutingCommand": {
      "properties": {
        "exit_node": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_exit_node": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/NodeRoutingMode"
        },
        "network_name": {
          "type": "string"
        }
      },
      "required": [
        "network_name",
        "mode",
        "is_exit_node"
      ],
      "type": "object"
    },
    "NodeWithdrawJoinRequestCommand": {
      "properties": {
        "network_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "network_id",
        "request_id"
      ],
      "type": "object"
    },
    "PublicKey": {
      "description": "Ed25519 public key bytes encoded as URL-safe base64 without padding.",
      "type": "string"
    },
    "Signature": {
      "description": "Signature bytes encoded as URL-safe base64 without padding.",
      "type": "string"
    }
  },
  "$id": "https://relay.xlei.cc/contracts/schema/node-command-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Product-neutral node operations. A node creates, joins or serves a network;\nthere are deliberately no product-level client/server command variants.",
  "oneOf": [
    {
      "properties": {
        "command": {
          "const": "get_snapshot",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Bootstrap query for the declarative UI contract. This is not rendered as\na page action and should be called before an adapter builds its UI.",
      "properties": {
        "command": {
          "const": "get_ui_manifest",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Query live runtime residue and cleanup state from the actor that owns\nnetwork sessions, embedded services and retained resource owners.",
      "properties": {
        "command": {
          "const": "get_node_diagnostics",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "start_networks",
          "type": "string"
        },
        "payload": {
          "properties": {
            "selection": {
              "$ref": "#/$defs/NodeNetworkSelection"
            }
          },
          "required": [
            "selection"
          ],
          "type": "object"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "stop_networks",
          "type": "string"
        },
        "payload": {
          "properties": {
            "all": {
              "type": "boolean"
            },
            "networks": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "networks",
            "all"
          ],
          "type": "object"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "restart_networks",
          "type": "string"
        },
        "payload": {
          "properties": {
            "all": {
              "type": "boolean"
            },
            "networks": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
