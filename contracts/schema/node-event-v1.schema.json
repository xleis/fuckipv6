{
  "$defs": {
    "NodeEmbeddedServiceStatus": {
      "enum": [
        "starting",
        "running",
        "stopping",
        "stopped",
        "failed"
      ],
      "type": "string"
    },
    "NodeEventKind": {
      "oneOf": [
        {
          "properties": {
            "data": {
              "properties": {
                "revision": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "revision"
              ],
              "type": "object"
            },
            "type": {
              "const": "state_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "properties": {
                "network_name": {
                  "type": "string"
                },
                "status": {
                  "$ref": "#/$defs/NodeNetworkStatus"
                }
              },
              "required": [
                "network_name",
                "status"
              ],
              "type": "object"
            },
            "type": {
              "const": "network_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "properties": {
                "network_name": {
                  "type": "string"
                },
                "status": {
                  "$ref": "#/$defs/NodeEmbeddedServiceStatus"
                }
              },
              "required": [
                "network_name",
                "status"
              ],
              "type": "object"
            },
            "type": {
              "const": "embedded_service_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "properties": {
                "level": {
                  "$ref": "#/$defs/NodeLogLevel"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "level",
                "message"
              ],
              "type": "object"
            },
            "type": {
              "const": "log_appended",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "properties": {
                "exit_node": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "is_exit_node": {
                  "type": "boolean"
                },
                "mode": {
                  "$ref": "#/$defs/NodeRoutingMode"
                },
                "network_name": {
                  "type": "string"
                }
              },
              "required": [
                "network_name",
                "mode",
                "is_exit_node"
              ],
              "type": "object"
            },
            "type": {
              "const": "routing_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "network_name": {
                  "type": "string"
                },
                "role": {
                  "$ref": "#/$defs/NodeNetworkRole"
                },
                "roles": {
                  "items": {
                    "$ref": "#/$defs/NodeNetworkRole"
                  },
                  "type": "array"
                }
              },
              "required": [
                "network_name",
                "role",
                "enabled",
                "roles"
              ],
              "type": "object"
            },
            "type": {
              "const": "role_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "properties": {
                "request_id": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "success": {
                  "type": "boolean"
                }
              },
              "required": [
                "request_id",
                "success"
              ],
              "type": "object"
            },
            "type": {
              "const": "command_completed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        },
        {
          "properties": {
            "data": {
              "properties": {
                "operation_id": {
                  "type": "string"
                },
                "stage": {
                  "type": "string"
                },
                "state": {
                  "$ref": "#/$defs/OperationState"
                }
              },
              "required": [
                "operation_id",
                "state",
                "stage"
              ],
              "type": "object"
            },
            "type": {
              "const": "operation_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "data"
          ],
          "type": "object"
        }
      ]
    },
    "NodeLogLevel": {
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error"
      ],
      "type": "string"
    },
    "NodeNetworkRole": {
      "description": "Network roles are capabilities within a network, never product identities.",
      "enum": [
        "member",
        "discovery",
        "relay",
        "exit_node"
      ],
      "type": "string"
    },
    "NodeNetworkStatus": {
      "enum": [
        "offline",
        "connecting",
        "online",
        "degraded",
        "stopping",
        "failed"
      ],
      "type": "string"
    },
    "NodeRoutingMode": {
      "enum": [
        "mesh_only",
        "bypass_mainland",
        "global_proxy"
      ],
      "type": "string"
    },
    "OperationState": {
      "enum": [
        "queued",
        "running",
        "waiting_for_reauth",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ],
      "type": "string"
    }
  },
  "$id": "https://relay.xlei.cc/contracts/schema/node-event-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Ordered event delivered to every attached UI and control adapter.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/NodeEventKind"
    },
    "sequence": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "sequence",
    "kind"
  ],
  "title": "NodeEvent",
  "type": "object",
  "x-fuckipv6-contract-version": 1,
  "x-fuckipv6-rust-source": "fuckipv6-client::node"
}
