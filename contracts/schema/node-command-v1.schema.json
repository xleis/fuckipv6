  "description": "Product-neutral node operations. A node creates, joins or serves a network;\nthere are deliberately no product-level client/server command variants.",
  "title": "NodeCommand",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "NodeNetworkSelection": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "default",
            "all"
          ]
        },
        {
          "type": "string",
          "const": "none",
          "description": "Keep the node and its control surfaces running without joining a network."
        },
        {
          "type": "object",
          "properties": {
            "named": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "named"
          ],
          "additionalProperties": false
        }
      ],
      "description": "How a node should choose the networks it loads at startup."
    },
    "NodeCreateNetworkCommand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "signaling_port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "relay_port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "external_host": {
          "type": [
            "string",
            "null"
          ]
        },
        "auto_connect": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "signaling_port",
        "relay_port",
        "auto_connect"
      ]
    },
    "NodeJoinNetworkCommand": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "network_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "type": "boolean"
        }
      },
      "required": [
        "target",
        "start"
      ]
    },
    "NodeUpdateRoutingCommand": {
      "type": "object",
      "properties": {
        "network_name": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/NodeRoutingMode"
        },
        "exit_node": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_exit_node": {
          "type": "boolean"
        }
      },
      "required": [
        "network_name",
        "mode",
        "is_exit_node"
      ]
    },
    "NodeRoutingMode": {
      "type": "string",
      "enum": [
        "mesh_only",
        "bypass_mainland",
        "global_proxy"
      ]
    },
    "NodeSetNetworkRoleCommand": {
      "type": "object",
      "properties": {
        "network_name": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/NodeNetworkRole"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "network_name",
        "role",
        "enabled"
      ]
    },
    "NodeNetworkRole": {
      "type": "string",
      "enum": [
        "member",
        "discovery",
        "relay",
        "exit_node"
      ],
      "description": "Network roles are capabilities within a network, never product identities."
    },
    "NodeClientBlacklistCommand": {
      "type": "object",
      "properties": {
        "network_name": {
          "type": "string"
        },
        "client_id": {
          "type": "string"
        }
      },
      "required": [
        "network_name",
        "client_id"
      ]
    },
    "NodeUpdateNetworkAllocationCommand": {
      "type": "object",
      "properties": {
        "network_name": {
          "type": "string"
        },
        "allocation": {
          "$ref": "#/$defs/NodeNetworkAllocation"
        }
      },
      "required": [
        "network_name",
        "allocation"
      ]
    },
    "NodeNetworkAllocation": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/NetworkMode"
        },
        "ipv4_pool": {
          "type": "string"
        },
        "ipv6_pool": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "ipv4_pool",
        "ipv6_pool"
      ],
      "description": "Transport-neutral allocation payload shared by local adapters and the\nnode command protocol. Persistence is owned by the embedded service actor,\nnever by a UI adapter."
    },
    "NetworkMode": {
      "oneOf": [
        {
          "type": "string",
          "const": "ipv4_only",
          "description": "仅使用 IPv4 虚拟内网"
        },
        {
          "type": "string",
          "const": "ipv6_only",
          "description": "仅使用 IPv6 虚拟内网"
        },
        {
          "type": "string",
          "const": "dual_stack",
          "description": "同时支持 IPv4 和 IPv6 虚拟双栈"
        }
      ],
      "description": "虚拟网络工作模式"
    },
    "NodeProbePeerCommand": {
      "type": "object",
      "properties": {
        "network_name": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "network_name",
        "target",
        "timeout_ms"
      ]
    }
  },
  "$id": "https://relay.xlei.cc/contracts/schema/node-command-v1.schema.json",
  "x-fuckipv6-contract-version": 1,
  "x-fuckipv6-rust-source": "fuckipv6-client::node"
}
