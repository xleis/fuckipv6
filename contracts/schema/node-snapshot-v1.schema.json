{
  "$defs": {
    "AclAction": {
      "description": "访问控制规则动作",
      "enum": [
        "allow",
        "deny"
      ],
      "type": "string"
    },
    "CapabilityKind": {
      "description": "The fixed first-version capability set. Unknown wire values fail closed at\ndeserialization and are never inferred from a free-form label.",
      "enum": [
        "coordinator",
        "relay",
        "exit",
        "file"
      ],
      "type": "string"
    },
    "CapabilityState": {
      "oneOf": [
        {
          "enum": [
            "disabled",
            "starting",
            "enabled",
            "degraded",
            "unavailable",
            "unsupported"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "A migrated record may preserve an unreadable state without making the\ncapability usable. New writes may not create this state.",
          "type": "string"
        }
      ]
    },
    "DisplayEnvironment": {
      "enum": [
        "linux_x11",
        "linux_wayland",
        "windows_desktop",
        "macos_desktop",
        "headless"
      ],
      "type": "string"
    },
    "ExitNodeCapabilities": {
      "description": "Current, non-secret Exit Node capability truth for one node process.\n\n`supported` describes whether a basic IPv4 Exit Node can be installed now.\n`ipv6_forwarding` is independent because an IPv6-only limitation does not\nmake the IPv4 Exit Node implementation unusable.",
      "properties": {
        "cleanup": {
          "type": "boolean"
        },
        "ipv4_forwarding": {
          "type": "boolean"
        },
        "ipv6_forwarding": {
          "type": "boolean"
        },
        "nat": {
          "type": "boolean"
        },
        "platform": {
          "$ref": "#/$defs/ExitNodePlatform"
        },
        "schema_version": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "supported": {
          "type": "boolean"
        },
        "unsupported_reasons": {
          "items": {
            "$ref": "#/$defs/ExitNodeUnsupportedReason"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "platform",
        "supported",
        "ipv4_forwarding",
        "ipv6_forwarding",
        "nat",
        "cleanup",
        "unsupported_reasons"
      ],
      "type": "object"
    },
    "ExitNodePlatform": {
      "description": "Host platforms with distinct Exit Node implementation requirements.",
      "enum": [
        "linux",
        "windows",
        "macos",
        "other"
      ],
      "type": "string"
    },
    "ExitNodeUnsupportedReason": {
      "description": "Machine-readable reasons that make an Exit Node action unavailable.\n\nAdapters must render these reasons instead of treating an enabled config\nflag as proof that kernel forwarding and NAT were installed.",
      "enum": [
        "platform_not_linux",
        "privileges_required",
        "routing_tool_unavailable",
        "iptables_unavailable",
        "ipv4_forwarding_unavailable"
      ],
      "type": "string"
    },
    "NetworkMode": {
      "description": "虚拟网络工作模式",
      "oneOf": [
        {
          "const": "ipv4_only",
          "description": "仅使用 IPv4 虚拟内网",
          "type": "string"
        },
        {
          "const": "ipv6_only",
          "description": "仅使用 IPv6 虚拟内网",
          "type": "string"
        },
        {
          "const": "dual_stack",
          "description": "同时支持 IPv4 和 IPv6 虚拟双栈",
          "type": "string"
        }
      ]
    },
    "NodeAccessModel": {
      "enum": [
        "trusted_control_plane"
      ],
      "type": "string"
    },
    "NodeCapabilityRegistrySnapshot": {
      "description": "Stable projection of the fixed first-version capability set. Unknown\nentries fail closed and unsupported capabilities remain visible so the UI\ncan explain why an action is unavailable.",
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/NodeCapabilitySnapshot"
          },
          "type": "array"
        }
      },
      "required": [
        "capabilities"
      ],
      "type": "object"
    },
    "NodeCapabilitySnapshot": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/CapabilityKind"
        },
        "state": {
          "$ref": "#/$defs/CapabilityState"
        }
      },
      "required": [
        "kind",
        "state"
      ],
      "type": "object"
    },
    "NodeConfigurationSnapshot": {
      "description": "Effective, non-secret network configuration exposed to every UI adapter.",
      "properties": {
        "networks": {
          "items": {
            "$ref": "#/$defs/NodeNetworkConfigSnapshot"
          },
          "type": "array"
        }
      },
      "required": [
        "networks"
      ],
      "type": "object"
    },
    "NodeControlHealth": {
      "description": "Whether the adapter can currently reach the node control plane.",
      "enum": [
        "unknown",
        "available",
        "unavailable"
      ],
      "type": "string"
    },
    "NodeEmbeddedServiceSnapshot": {
      "description": "Non-secret runtime state for one network's embedded signaling and relay\nservices. Invitation tickets, identity material, and host-local paths are\ndeliberately excluded from this shared UI contract.",
      "properties": {
        "network_name": {
          "type": "string"
        },
        "relay_addr": {
          "type": [
            "string",
            "null"
          ]
        },
        "signaling_addr": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/NodeEmbeddedServiceStatus"
        }
      },
      "required": [
        "network_name",
        "status"
      ],
      "type": "object"
    },
    "NodeEmbeddedServiceStatus": {
      "enum": [
        "starting",
        "running",
        "stopping",
        "stopped",
        "failed"
      ],
      "type": "string"
    },
    "NodeIdentitySnapshot": {
      "description": "Public node identity metadata. Secret key material must never enter this DTO.",
      "properties": {
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_id": {
          "type": "string"
        },
        "public_key_fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "public_key_fingerprint"
      ],
      "type": "object"
    },
    "NodeLifecycleSnapshot": {
      "description": "Shared lifecycle snapshot consumed by CLI, IPC, WebUI, and (later) GPUI.",
      "properties": {
        "active_networks": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "configured_networks": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failed_networks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "phase": {
          "$ref": "#/$defs/NodePhase"
        }
      },
      "required": [
        "phase",
        "configured_networks",
        "active_networks",
        "failed_networks"
      ],
      "type": "object"
    },
    "NodeLogEntry": {
      "properties": {
        "level": {
          "$ref": "#/$defs/NodeLogLevel"
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "unix_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "unix_ms",
        "level",
        "target",
        "message"
      ],
      "type": "object"
    },
    "NodeLogLevel": {
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error"
      ],
      "type": "string"
    },
    "NodeNetworkConfigSnapshot": {
      "description": "One network's effective configuration after loading startup overrides.\n\nFilesystem paths and other host-local details are deliberately omitted. The\nboolean fields only state whether optional host-local settings are present.",
      "properties": {
        "acl_default_action": {
          "$ref": "#/$defs/AclAction"
        },
        "acl_enabled": {
          "type": "boolean"
        },
        "acl_rule_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "coordinator_url": {
          "type": "string"
        },
        "direct_cidrs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "exit_node": {
          "type": [
            "string",
            "null"
          ]
        },
        "exit_node_allow_lan_access": {
          "type": "boolean"
        },
        "exit_node_allowed_clients": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "exit_node_enabled": {
          "type": "boolean"
        },
        "exit_node_region": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_configured": {
          "type": "boolean"
        },
        "log_file_configured": {
          "type": "boolean"
        },
        "log_level": {
          "type": "string"
        },
        "mtu": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "network_name": {
          "type": "string"
        },
        "p2p_connect_timeout_secs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p2p_heartbeat_interval_secs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p2p_listen_port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "preferred_ipv4": {
          "format": "ipv4",
          "type": [
            "string",
            "null"
          ]
        },
        "preferred_ipv6": {
          "format": "ipv6",
          "type": [
            "string",
            "null"
          ]
        },
        "proxy_cidrs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "routing_mode": {
          "$ref": "#/$defs/NodeRoutingMode"
        },
        "tun_name": {
          "type": "string"
        },
        "virtual_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "virtual_network": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "network_name",
        "coordinator_url",
        "tun_name",
        "mtu",
        "p2p_listen_port",
        "p2p_connect_timeout_secs",
        "p2p_heartbeat_interval_secs",
        "routing_mode",
        "direct_cidrs",
        "proxy_cidrs",
        "exit_node_enabled",
        "exit_node_allowed_clients",
        "exit_node_allow_lan_access",
        "acl_enabled",
        "acl_default_action",
        "acl_rule_count",
        "log_level",
        "log_file_configured",
        "identity_configured"
      ],
      "type": "object"
    },
    "NodeNetworkRole": {
      "description": "Network roles are capabilities within a network, never product identities.",
      "enum": [
        "member",
        "discovery",
        "relay",
        "exit_node"
      ],
      "type": "string"
    },
    "NodeNetworkSnapshot": {
      "description": "One local network and the roles this node currently performs in it.",
      "properties": {
        "assigned_ipv4": {
          "format": "ipv4",
          "type": [
            "string",
            "null"
          ]
        },
        "assigned_ipv6": {
          "format": "ipv6",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "p2p_listen_addr": {
          "type": [
            "string",
            "null"
          ]
        },
        "peer_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/NodeNetworkRole"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/NodeNetworkStatus"
        },
        "traffic": {
          "$ref": "#/$defs/NodeTrafficSnapshot"
        },
        "tun_name": {
          "type": "string"
        },
        "uptime_secs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "tun_name",
        "status",
        "uptime_secs",
        "roles",
        "peer_count",
        "traffic"
      ],
      "type": "object"
    },
    "NodeNetworkStatus": {
      "enum": [
        "offline",
        "connecting",
        "online",
        "degraded",
        "stopping",
        "failed"
      ],
      "type": "string"
    },
    "NodePeerSnapshot": {
      "description": "Peer state scoped to a network. The same node may appear in multiple networks.",
      "properties": {
        "endpoints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "loss_rate": {
          "format": "float",
          "type": "number"
        },
        "network_name": {
          "type": "string"
        },
        "online": {
          "type": "boolean"
        },
        "p2p_active": {
          "type": "boolean"
        },
        "p2p_healthy": {
          "type": "boolean"
        },
        "peer_id": {
          "type": "string"
        },
        "rtt_us": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "traffic": {
          "$ref": "#/$defs/NodeTrafficSnapshot"
        },
        "virtual_ipv4": {
          "format": "ipv4",
          "type": [
            "string",
            "null"
          ]
        },
        "virtual_ipv6": {
          "format": "ipv6",
          "type": "string"
        }
      },
      "required": [
        "peer_id",
        "network_name",
        "virtual_ipv6",
        "endpoints",
        "online",
        "p2p_active",
        "p2p_healthy",
        "loss_rate",
        "traffic"
      ],
      "type": "object"
    },
    "NodePermission": {
      "description": "Stable capability classes used by both the permission snapshot and UI actions.",
      "enum": [
        "view_state",
        "manage_networks",
        "change_routing",
        "manage_roles",
        "probe_peers",
        "stop_node",
        "view_logs"
      ],
      "type": "string"
    },
    "NodePermissionSnapshot": {
      "description": "Control-plane authorization posture shared with UI adapters.\n\n`TrustedControlPlane` means the runtime accepts every connected adapter as\nfully privileged. It does not mean per-user or remote authentication exists.",
      "properties": {
        "access_model": {
          "$ref": "#/$defs/NodeAccessModel"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/NodePermission"
          },
          "type": "array"
        }
      },
      "required": [
        "access_model",
        "permissions"
      ],
      "type": "object"
    },
    "NodePhase": {
      "description": "Node-global lifecycle. Network sessions may come and go while the node\nremains in one of these phases.",
      "enum": [
        "stopped",
        "starting",
        "running",
        "stopping",
        "failed"
      ],
      "type": "string"
    },
    "NodeProblem": {
      "description": "UI- and transport-neutral error returned by every node command adapter.",
      "properties": {
        "code": {
          "$ref": "#/$defs/NodeProblemCode"
        },
        "message": {
          "type": "string"
        },
        "network_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "NodeProblemCode": {
      "oneOf": [
        {
          "enum": [
            "invalid_request",
            "not_found",
            "conflict",
            "unavailable",
            "permission_denied",
            "cancelled",
            "timed_out",
            "internal"
          ],
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The operation is valid but unavailable on this platform or host.",
          "type": "string"
        }
      ]
    },
    "NodeRoutingMode": {
      "enum": [
        "mesh_only",
        "bypass_mainland",
        "global_proxy"
      ],
      "type": "string"
    },
    "NodeTrafficSnapshot": {
      "properties": {
        "error_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p2p_rx_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p2p_rx_packets": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p2p_tx_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "p2p_tx_packets": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tun_rx_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tun_rx_packets": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tun_tx_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tun_tx_packets": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "tun_rx_packets",
        "tun_rx_bytes",
        "tun_tx_packets",
        "tun_tx_bytes",
        "p2p_rx_packets",
        "p2p_rx_bytes",
        "p2p_tx_packets",
        "p2p_tx_bytes",
        "error_count"
      ],
      "type": "object"
    },
    "UiMode": {
      "description": "The actual control surface selected for this node process.\n\n`WebUi` is the browser-hosted control plane. It remains available on\nheadless hosts as a server-only surface; the display environment only\ndecides whether a browser window can also be opened. `WebUi` must never be\nrepresented as the native `Gpui` surface.",
      "enum": [
        "gpui",
        "web_ui",
        "headless"
      ],
      "type": "string"
    },
    "UiModeRequest": {
      "enum": [
        "auto",
        "gpui",
        "web_ui",
        "headless"
      ],
      "type": "string"
    },
    "UiModeResolution": {
      "properties": {
        "display": {
          "$ref": "#/$defs/DisplayEnvironment"
        },
        "effective": {
          "$ref": "#/$defs/UiMode"
        },
        "gpui_available": {
          "type": "boolean"
        },
        "requested": {
          "$ref": "#/$defs/UiModeRequest"
        }
      },
      "required": [
        "requested",
        "effective",
        "display",
        "gpui_available"
      ],
      "type": "object"
    }
  },
  "$id": "https://relay.xlei.cc/contracts/schema/node-snapshot-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Stable, transport-neutral state rendered by every node UI adapter.",
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/NodeCapabilityRegistrySnapshot",
      "default": {
        "capabilities": [
          {
            "kind": "coordinator",
            "state": "unknown"
          },
          {
            "kind": "relay",
            "state": "unknown"
          },
          {
            "kind": "exit",
            "state": "unknown"
          },
          {
            "kind": "file",
            "state": "unknown"
          }
        ]
      },
      "description": "Unified four-capability projection shared by every UI adapter. Missing\nentries deserialize as `Unknown`; they are never inferred as enabled."
    },
    "configuration": {
      "$ref": "#/$defs/NodeConfigurationSnapshot",
      "default": {
        "networks": []
      }
    },
    "control_health": {
      "$ref": "#/$defs/NodeControlHealth",
      "default": "unknown",
      "description": "Health of the UI adapter's control connection. This is local transport\nobservation, not authoritative node state, so changing it must not\nmanufacture a new node revision."
    },
    "embedded_services": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NodeEmbeddedServiceSnapshot"
      },
      "type": "array"
    },
    "exit_node_capabilities": {
      "$ref": "#/$defs/ExitNodeCapabilities",
      "default": {
        "cleanup": false,
        "ipv4_forwarding": false,
        "ipv6_forwarding": false,
        "nat": false,
        "platform": "linux",
        "schema_version": 1,
        "supported": false,
        "unsupported_reasons": [
          "privileges_required",
          "ipv4_forwarding_unavailable"
        ]
      },
      "description": "Runtime capability truth for this host. Adapters must disable Exit Node\nactions when `supported` is false and render the typed reasons instead\nof inferring success from configuration alone."
    },
    "identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/NodeIdentitySnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/NodeProblem"
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle": {
      "$ref": "#/$defs/NodeLifecycleSnapshot"
    },
    "logs": {
      "items": {
        "$ref": "#/$defs/NodeLogEntry"
      },
      "type": "array"
    },
    "networks": {
      "items": {
        "$ref": "#/$defs/NodeNetworkSnapshot"
      },
      "type": "array"
    },
    "peers": {
      "items": {
        "$ref": "#/$defs/NodePeerSnapshot"
      },
      "type": "array"
    },
    "permissions": {
      "$ref": "#/$defs/NodePermissionSnapshot",
      "default": {
        "access_model": "trusted_control_plane",
        "permissions": []
      }
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "ui_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiModeResolution"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "revision",
    "lifecycle",
    "networks",
    "peers",
    "logs"
  ],
  "title": "NodeSnapshot",
  "type": "object",
  "x-fuckipv6-contract-version": 1,
  "x-fuckipv6-rust-source": "fuckipv6-client::node"
}
