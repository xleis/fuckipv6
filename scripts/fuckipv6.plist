<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cc.xlei.fuckipv6</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/fuckipv6/fuckipv6</string>
    <string>--headless</string>
    <string>--webui-port</string>
    <string>8080</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/usr/local/fuckipv6</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>RUST_LOG</key>
    <string>info</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/usr/local/var/log/fuckipv6/node.log</string>

  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/fuckipv6/node.err.log</string>
</dict>
</plist>
