<?xml version="1.0" encoding="utf-8"?>
<!-- The node control API binds a loopback address over plain HTTP, so the app
     must be allowed to reach exactly those hosts. Everything else stays
     HTTPS-only: no global cleartext switch, and no node URL is guessed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Emulator alias for the host loopback interface. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
