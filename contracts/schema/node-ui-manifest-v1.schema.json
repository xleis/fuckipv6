{
  "$defs": {
    "NodePermission": {
      "description": "Stable capability classes used by both the permission snapshot and UI actions.",
      "enum": [
        "view_state",
        "manage_networks",
        "change_routing",
        "manage_roles",
        "probe_peers",
        "stop_node",
        "view_logs"
      ],
      "type": "string"
    },
    "NodeUiAction": {
      "properties": {
        "audit": {
          "$ref": "#/$defs/NodeUiAudit",
          "description": "Stable audit requirement for this command. Reads that are too noisy to\nrecord still carry an explicit `none` declaration instead of leaving\nadapters to guess."
        },
        "availability": {
          "$ref": "#/$defs/NodeUiAvailability"
        },
        "backend_status": {
          "$ref": "#/$defs/NodeUiBackendStatus"
        },
        "command": {
          "enum": [
            "get_snapshot",
            "get_node_diagnostics",
            "start_networks",
            "stop_networks",
            "restart_networks",
            "create_network",
            "join_network",
            "update_routing",
            "set_network_role",
            "get_blacklist",
            "ban_client",
            "unban_client",
            "get_network_allocation",
            "update_network_allocation",
            "probe_peer",
            "start_node",
            "stop_node",
            "restart_node",
            "cleanup_node_residuals",
            "get_configuration",
            "preview_configuration",
            "apply_configuration",
            "rollback_configuration",
            "get_configuration_history",
            "shutdown"
          ],
          "type": "string"
        },
        "confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeUiConfirmation"
            },
            {
              "type": "null"
            }
          ]
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/NodeUiField"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "label_key": {
          "type": "string"
        },
        "permission": {
          "$ref": "#/$defs/NodePermission"
        }
      },
      "required": [
        "id",
        "label_key",
        "command",
        "backend_status",
        "permission",
        "audit",
        "availability",
        "fields"
      ],
      "type": "object"
    },
    "NodeUiAudit": {
      "properties": {
        "action": {
          "description": "Stable action name written to the append-only audit log.",
          "type": [
            "string",
            "null"
          ]
        },
        "policy": {
          "$ref": "#/$defs/NodeUiAuditPolicy"
        }
      },
      "required": [
        "policy"
      ],
      "type": "object"
    },
    "NodeUiAuditPolicy": {
      "enum": [
        "none",
        "record_outcome"
      ],
      "type": "string"
    },
    "NodeUiAvailability": {
      "enum": [
        "always",
        "node_running",
        "network_online",
        "network_selected"
      ],
      "type": "string"
    },
    "NodeUiBackendStatus": {
      "oneOf": [
        {
          "const": "implemented",
          "description": "The production command handler currently accepts this command.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "The shared command exists, but the runtime backend rejects it as unavailable.",
          "type": "string"
        }
      ]
    },
    "NodeUiConfirmation": {
      "properties": {
        "consequence_key": {
          "type": "string"
        },
        "destructive": {
          "type": "boolean"
        },
        "title_key": {
          "type": "string"
        }
      },
      "required": [
        "title_key",
        "consequence_key",
        "destructive"
      ],
      "type": "object"
    },
    "NodeUiField": {
      "properties": {
        "id": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/NodeUiInputKind"
        },
        "label_key": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "validation": {
          "$ref": "#/$defs/NodeUiValidation"
        }
      },
      "required": [
        "id",
        "label_key",
        "input",
        "required",
        "validation"
      ],
      "type": "object"
    },
    "NodeUiInputKind": {
      "enum": [
        "boolean",
        "client_id",
        "configuration_json",
        "external_host",
        "network_mode",
        "network_name",
        "network_selection",
        "peer_target",
        "port",
        "revision",
        "role",
        "routing_mode",
        "url_or_ticket",
        "timeout_ms"
      ],
      "type": "string"
    },
    "NodeUiPage": {
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/NodeUiAction"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "nav_label_key": {
          "type": "string"
        },
        "title_key": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "nav_label_key",
        "title_key",
        "actions"
      ],
      "type": "object"
    },
    "NodeUiValidation": {
      "enum": [
        "none",
        "non_empty",
        "network_name",
        "port",
        "distinct_ports",
        "network_mode",
        "network_selection",
        "role",
        "routing_mode",
        "positive_timeout",
        "revision",
        "configuration_json"
      ],
      "type": "string"
    }
  },
  "$id": "https://relay.xlei.cc/contracts/schema/node-ui-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Declarative contract shared by WebUI and the future native GPUI surface.\n\nAdapters may choose different widgets and rendering, but page availability,\ncommands, fields, validation, confirmations, permission classes and backend\nmaturity come from this manifest rather than duplicated UI business logic.",
  "properties": {
    "pages": {
      "items": {
        "$ref": "#/$defs/NodeUiPage"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "pages"
  ],
  "title": "NodeUiManifest",
  "type": "object",
  "x-fuckipv6-contract-version": 1,
  "x-fuckipv6-rust-source": "fuckipv6-client::node"
}
