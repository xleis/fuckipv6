{
  "type": "object",
  "properties": {
    "sequence": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "kind": {
      "$ref": "#/$defs/NodeEventKind"
    }
  },
  "required": [
    "sequence",
    "kind"
  ],
  "description": "Ordered event delivered to every attached UI and control adapter.",
  "title": "NodeEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "NodeEventKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "state_changed"
            },
            "data": {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "required": [
                "revision"
              ]
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "network_changed"
            },
            "data": {
              "type": "object",
              "properties": {
                "network_name": {
                  "type": "string"
                },
                "status": {
                  "$ref": "#/$defs/NodeNetworkStatus"
                }
              },
              "required": [
                "network_name",
                "status"
              ]
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "embedded_service_changed"
            },
            "data": {
              "type": "object",
              "properties": {
                "network_name": {
                  "type": "string"
                },
                "status": {
                  "$ref": "#/$defs/NodeEmbeddedServiceStatus"
                }
              },
              "required": [
                "network_name",
                "status"
              ]
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "log_appended"
            },
            "data": {
              "type": "object",
              "properties": {
                "level": {
                  "$ref": "#/$defs/NodeLogLevel"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "level",
                "message"
              ]
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "routing_changed"
            },
            "data": {
              "type": "object",
              "properties": {
                "network_name": {
                  "type": "string"
                },
                "mode": {
                  "$ref": "#/$defs/NodeRoutingMode"
                },
                "exit_node": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "is_exit_node": {
                  "type": "boolean"
                }
              },
              "required": [
                "network_name",
                "mode",
                "is_exit_node"
              ]
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "role_changed"
            },
            "data": {
              "type": "object",
              "properties": {
                "network_name": {
                  "type": "string"
                },
                "role": {
                  "$ref": "#/$defs/NodeNetworkRole"
                },
                "enabled": {
                  "type": "boolean"
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/NodeNetworkRole"
                  }
                }
              },
              "required": [
                "network_name",
                "role",
                "enabled",
                "roles"
              ]
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "command_completed"
            },
            "data": {
              "type": "object",
              "properties": {
                "request_id": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "success": {
                  "type": "boolean"
                }
              },
              "required": [
                "request_id",
                "success"
              ]
            }
          },
          "required": [
            "type",
            "data"
          ]
        }
      ]
    },
    "NodeNetworkStatus": {
      "type": "string",
      "enum": [
        "offline",
        "connecting",
        "online",
        "degraded",
        "stopping",
        "failed"
      ]
    },
    "NodeEmbeddedServiceStatus": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "stopping",
        "stopped",
        "failed"
      ]
    },
    "NodeLogLevel": {
      "type": "string",
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "NodeRoutingMode": {
      "type": "string",
      "enum": [
        "mesh_only",
        "bypass_mainland",
        "global_proxy"
      ]
    },
    "NodeNetworkRole": {
      "type": "string",
      "enum": [
        "member",
        "discovery",
        "relay",
        "exit_node"
      ],
      "description": "Network roles are capabilities within a network, never product identities."
    }
  },
  "$id": "https://relay.xlei.cc/contracts/schema/node-event-v1.schema.json",
  "x-fuckipv6-contract-version": 1,
  "x-fuckipv6-rust-source": "fuckipv6-client::node"
}
