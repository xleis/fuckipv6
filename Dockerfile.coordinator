FROM rust:1-bookworm AS builder

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN cargo build --release -p fuckipv6-coordinator

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -u 10001 -s /usr/sbin/nologin -d /var/lib/fuckipv6 fuckipv6 \
    && mkdir -p /etc/fuckipv6 /var/lib/fuckipv6 \
    && chown -R fuckipv6:fuckipv6 /var/lib/fuckipv6

COPY --from=builder /src/target/release/fuckipv6-coordinator /usr/local/bin/fuckipv6-coordinator
COPY examples/coordinator.toml.example /etc/fuckipv6/coordinator.toml

USER fuckipv6
EXPOSE 6666/tcp 8080/tcp

ENTRYPOINT ["/usr/local/bin/fuckipv6-coordinator"]
CMD ["--config", "/etc/fuckipv6/coordinator.toml"]
