[Unit]
Description=fuckipv6 node and control service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30s
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/fuckipv6
ExecStart=/opt/fuckipv6/fuckipv6 __service --options-file /etc/fuckipv6/service.json --config-dir /etc/fuckipv6
Environment="FUCKIPV6_RUNTIME_DIR=/run/fuckipv6"
Environment="RUST_LOG=info"
UMask=0077
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=75s
NoNewPrivileges=false
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/fuckipv6 /var/lib/fuckipv6 /var/log/fuckipv6 /run/fuckipv6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fuckipv6

[Install]
WantedBy=multi-user.target
