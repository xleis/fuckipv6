# fuckipv6 客户端配置文件示例
# 复制此文件到 /etc/fuckipv6/client.toml 并根据需要修改

# 协调服务器WebSocket地址
# 格式: ws://地址:端口 或 wss://地址:端口 (使用TLS)
# 示例:
#   本地测试: ws://localhost:6666
#   生产环境: wss://vpn.example.com:6666
coordinator_url = "ws://localhost:6666"

# 客户端私钥文件路径（可选）
# 如果文件不存在，将自动生成新的Ed25519密钥对
# 相对路径: 相对于配置文件所在目录
# 绝对路径: /var/lib/fuckipv6/client_key.pem
private_key_path = "client_key.pem"

# 可选: 手动指定客户端ID（通常无需设置，会自动从公钥生成）
# client_id = "my-custom-client-id"

# ========================================
# 网络配置
# ========================================
[network]

# 虚拟网络IPv6前缀
# 必须与协调服务器的IP池在同一个网段
# 示例: fd00::/64, fc00:1234::/48
virtual_network = "fd00::/64"

# 可选: 请求特定的虚拟IP地址
# 如果该IP未被占用，协调服务器会尝试分配
# preferred_ip = "fd00::100"

# ========================================
# TUN虚拟网卡配置
# ========================================
[tun]

# TUN设备名称
# Linux: 任意名称，推荐使用 fuckipv6
# Windows: 必须使用WinTun适配器的GUID
name = "fuckipv6"

# 最大传输单元(MTU)
# 推荐值: 1400 (避免IP分片)
# 范围: 1280-1500
mtu = 1400

# ========================================
# P2P连接配置
# ========================================
[p2p]

# UDP监听端口
# 0 = 自动选择随机端口（推荐）
# 1024-65535 = 使用固定端口（需要配置路由器端口转发）
listen_port = 0

# 心跳间隔（秒）
# 定期向协调服务器发送心跳以保持在线状态
# 推荐值: 30
heartbeat_interval = 30

# 连接超时（秒）
# P2P连接建立的最大等待时间
# 超时后会自动尝试中继连接（Phase 2功能）
connect_timeout = 10

# ========================================
# 日志配置
# ========================================
[log]

# 日志级别
# 可选值: trace, debug, info, warn, error
# 生产环境推荐: info
# 调试时推荐: debug
level = "info"

# 可选: 日志文件路径（不设置则输出到stdout）
# file = "/var/log/fuckipv6/client.log"

# ========================================
# 高级配置 (Phase 2)
# ========================================

# [p2p.fallback_threshold]
# # P2P连接质量低于阈值时切换到中继
# max_rtt_ms = 200           # 最大往返时延(毫秒)
# max_loss_rate = 0.05       # 最大丢包率(5%)

# [relay]
# # 中继服务器配置
# enabled = true
# server_url = "quic://vpn.example.com:6667"
# max_bandwidth_mbps = 10    # 最大带宽限制(Mbps)

# ========================================
# 配置示例
# ========================================

# === 本地测试配置 ===
# coordinator_url = "ws://localhost:6666"
# [tun]
# name = "fuckipv6-test"
# mtu = 1400
# [p2p]
# listen_port = 0
# [log]
# level = "debug"

# === 生产环境配置 ===
# coordinator_url = "wss://vpn.example.com:6666"
# private_key_path = "/var/lib/fuckipv6/client_key.pem"
# [network]
# virtual_network = "fd00::/64"
# [tun]
# name = "fuckipv6"
# mtu = 1400
# [p2p]
# listen_port = 0
# heartbeat_interval = 30
# [log]
# level = "info"
# file = "/var/log/fuckipv6/client.log"
