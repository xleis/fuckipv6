{
  "$defs": {
    "NetworkMode": {
      "description": "虚拟网络工作模式",
      "oneOf": [
        {
          "const": "ipv4_only",
          "description": "仅使用 IPv4 虚拟内网",
          "type": "string"
        },
        {
          "const": "ipv6_only",
          "description": "仅使用 IPv6 虚拟内网",
          "type": "string"
        },
        {
          "const": "dual_stack",
          "description": "同时支持 IPv4 和 IPv6 虚拟双栈",
          "type": "string"
        }
      ]
    },
    "NodeApplyConfigurationCommand": {
      "properties": {
        "expected_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "networks": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "expected_revision",
        "networks"
      ],
      "type": "object"
    },
    "NodeClientBlacklistCommand": {
      "properties": {
        "client_id": {
          "type": "string"
        },
        "network_name": {
          "type": "string"
        }
      },
      "required": [
        "network_name",
        "client_id"
      ],
      "type": "object"
    },
    "NodeCreateNetworkCommand": {
      "properties": {
        "auto_connect": {
          "type": "boolean"
        },
        "external_host": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "relay_port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "signaling_port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "signaling_port",
        "relay_port",
        "auto_connect"
      ],
      "type": "object"
    },
    "NodeJoinNetworkCommand": {
      "properties": {
        "network_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "type": "boolean"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "target",
        "start"
      ],
      "type": "object"
    },
    "NodeNetworkAllocation": {
      "description": "Transport-neutral allocation payload shared by local adapters and the\nnode command protocol. Persistence is owned by the embedded service actor,\nnever by a UI adapter.",
      "properties": {
        "ipv4_pool": {
          "type": "string"
        },
        "ipv6_pool": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/NetworkMode"
        }
      },
      "required": [
        "mode",
        "ipv4_pool",
        "ipv6_pool"
      ],
      "type": "object"
    },
    "NodeNetworkRole": {
      "description": "Network roles are capabilities within a network, never product identities.",
      "enum": [
        "member",
        "discovery",
        "relay",
        "exit_node"
      ],
      "type": "string"
    },
    "NodeNetworkSelection": {
      "description": "How a node should choose the networks it loads at startup.",
      "oneOf": [
        {
          "enum": [
            "default",
            "all"
          ],
          "type": "string"
        },
        {
          "const": "none",
          "description": "Keep the node and its control surfaces running without joining a network.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "named": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "named"
          ],
          "type": "object"
        }
      ]
    },
    "NodePreviewConfigurationCommand": {
      "description": "Complete document imported by an owner for preview or atomic apply.\nActor and request source are intentionally absent: the command bus supplies\nthem from the authenticated transport context.",
      "properties": {
        "expected_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "networks": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "expected_revision",
        "networks"
      ],
      "type": "object"
    },
    "NodeProbePeerCommand": {
      "properties": {
        "network_name": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "network_name",
        "target",
        "timeout_ms"
      ],
      "type": "object"
    },
    "NodeRollbackConfigurationCommand": {
      "properties": {
        "expected_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "target_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "expected_revision",
        "target_revision"
      ],
      "type": "object"
    },
    "NodeRoutingMode": {
      "enum": [
        "mesh_only",
        "bypass_mainland",
        "global_proxy"
      ],
      "type": "string"
    },
    "NodeSetNetworkRoleCommand": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "network_name": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/NodeNetworkRole"
        }
      },
      "required": [
        "network_name",
        "role",
        "enabled"
      ],
      "type": "object"
    },
    "NodeUpdateNetworkAllocationCommand": {
      "properties": {
        "allocation": {
          "$ref": "#/$defs/NodeNetworkAllocation"
        },
        "network_name": {
          "type": "string"
        }
      },
      "required": [
        "network_name",
        "allocation"
      ],
      "type": "object"
    },
    "NodeUpdateRoutingCommand": {
      "properties": {
        "exit_node": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_exit_node": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/NodeRoutingMode"
        },
        "network_name": {
          "type": "string"
        }
      },
      "required": [
        "network_name",
        "mode",
        "is_exit_node"
      ],
      "type": "object"
    }
  },
  "$id": "https://relay.xlei.cc/contracts/schema/node-command-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Product-neutral node operations. A node creates, joins or serves a network;\nthere are deliberately no product-level client/server command variants.",
  "oneOf": [
    {
      "properties": {
        "command": {
          "const": "get_snapshot",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Bootstrap query for the declarative UI contract. This is not rendered as\na page action and should be called before an adapter builds its UI.",
      "properties": {
        "command": {
          "const": "get_ui_manifest",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Query live runtime residue and cleanup state from the actor that owns\nnetwork sessions, embedded services and retained resource owners.",
      "properties": {
        "command": {
          "const": "get_node_diagnostics",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "start_networks",
          "type": "string"
        },
        "payload": {
          "properties": {
            "selection": {
              "$ref": "#/$defs/NodeNetworkSelection"
            }
          },
          "required": [
            "selection"
          ],
          "type": "object"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "stop_networks",
          "type": "string"
        },
        "payload": {
          "properties": {
            "all": {
              "type": "boolean"
            },
            "networks": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "networks",
            "all"
          ],
          "type": "object"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "restart_networks",
          "type": "string"
        },
        "payload": {
          "properties": {
            "all": {
              "type": "boolean"
            },
            "networks": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "networks",
            "all"
          ],
          "type": "object"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "description": "Recreate one network's TUN under the actor-owned lifecycle transition.",
      "properties": {
        "command": {
          "const": "rebuild_tun",
          "type": "string"
        },
        "payload": {
          "properties": {
            "network_name": {
              "type": "string"
            }
          },
          "required": [
            "network_name"
          ],
          "type": "object"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "create_network",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/NodeCreateNetworkCommand"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "join_network",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/NodeJoinNetworkCommand"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "update_routing",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/NodeUpdateRoutingCommand"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "set_network_role",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/NodeSetNetworkRoleCommand"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "get_blacklist",
          "type": "string"
        },
        "payload": {
          "properties": {
            "network_name": {
              "type": "string"
            }
          },
          "required": [
            "network_name"
          ],
          "type": "object"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "ban_client",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/NodeClientBlacklistCommand"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "unban_client",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/NodeClientBlacklistCommand"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "get_network_allocation",
          "type": "string"
        },
        "payload": {
          "properties": {
            "network_name": {
              "type": "string"
            }
          },
          "required": [
            "network_name"
          ],
          "type": "object"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "update_network_allocation",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/NodeUpdateNetworkAllocationCommand"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "probe_peer",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/NodeProbePeerCommand"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "description": "Start all persistently configured networks while keeping this node IPC\nand the control/UI processes alive.",
      "properties": {
        "command": {
          "const": "start_node",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Stop all data-plane sessions and owned embedded services while keeping\nthis node IPC and the control/UI processes alive.",
      "properties": {
        "command": {
          "const": "stop_node",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Reload every persisted network and replace the complete data plane under\none single-flight lifecycle operation.",
      "properties": {
        "command": {
          "const": "restart_node",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Retry cleanup for runtime resources whose previous owner reported a\ndeferred or failed shutdown.",
      "properties": {
        "command": {
          "const": "cleanup_node_residuals",
          "type": "string"
        },
        "payload": {
          "properties": {
            "all": {
              "type": "boolean"
            },
            "networks": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "networks",
            "all"
          ],
          "type": "object"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "const": "shutdown",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Complete redacted configuration for every configured network.",
      "properties": {
        "command": {
          "const": "get_configuration",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "Validate an imported complete configuration without writing it.",
      "properties": {
        "command": {
          "const": "preview_configuration",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/NodePreviewConfigurationCommand"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "description": "Persist all network configurations under one revision transaction.",
      "properties": {
        "command": {
          "const": "apply_configuration",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/NodeApplyConfigurationCommand"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "description": "Restore a previous revision as a new auditable revision.",
      "properties": {
        "command": {
          "const": "rollback_configuration",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/NodeRollbackConfigurationCommand"
        }
      },
      "required": [
        "command",
        "payload"
      ],
      "type": "object"
    },
    {
      "description": "Append-only configuration revision history, newest first.",
      "properties": {
        "command": {
          "const": "get_configuration_history",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    }
  ],
  "title": "NodeCommand",
  "x-fuckipv6-contract-version": 1,
  "x-fuckipv6-rust-source": "fuckipv6-client::node"
}
